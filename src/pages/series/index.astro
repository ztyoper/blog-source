---
import { Icon } from "astro-icon/components";
import SeriesTree from "@/components/misc/SeriesTree.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSeriesList } from "@/utils/content-utils";

const seriesList = await getSeriesList();
const totalPosts = seriesList.reduce((sum, series) => sum + series.count, 0);
---

<MainGridLayout title={i18n(I18nKey.series)} description={i18n(I18nKey.allSeries)}>
    <div class="card-base px-8 py-6 mb-4">
        <div class="text-2xl font-bold text-(--primary) mb-2">
            {i18n(I18nKey.series)}
        </div>
        <p class="text-30 text-sm">
            {i18n(I18nKey.allSeries)} · {totalPosts} {i18n(I18nKey.postsCount)}
        </p>
    </div>

    {
        seriesList.length > 0 ? (
            <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,20rem),1fr))] items-start gap-4 mb-4">
                {seriesList.map((series) => (
                    <details name="blog-series" class="group/series card-base overflow-hidden">
                        <summary class="flex w-full cursor-pointer list-none items-center gap-3 p-5 text-left md:p-6">
                            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-(--primary)/10">
                                <Icon name="material-symbols:layers" aria-hidden="true" class="text-2xl text-(--primary)" />
                            </span>
                            <span class="min-w-0 flex-1">
                                <span class="block break-words text-lg font-bold text-90">{series.name}</span>
                                <span class="mt-0.5 block text-sm text-30">
                                    {series.count} {i18n(I18nKey.postsCount)}
                                </span>
                            </span>
                            <Icon
                                name="material-symbols:keyboard-arrow-down-rounded"
                                aria-hidden="true"
                                class="shrink-0 text-xl text-30 group-open/series:rotate-180"
                            />
                        </summary>
                        <div class="max-h-[min(60dvh,32rem)] overflow-y-auto overscroll-contain px-4 pb-4 md:px-5">
                            <SeriesTree entries={series.entries} />
                        </div>
                    </details>
                ))}
            </div>
        ) : (
            <div class="card-base px-8 py-12 text-center">
                <Icon name="material-symbols:layers" aria-hidden="true" class="text-5xl text-30 mx-auto mb-4" />
                <p class="text-30">{i18n(I18nKey.noSeries)}</p>
            </div>
        )
    }
</MainGridLayout>
