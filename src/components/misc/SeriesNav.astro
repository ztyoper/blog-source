---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { Series } from "@/utils/series-navigation";
import SeriesTree from "./SeriesTree.astro";

interface Props {
	series: Series;
	currentPostId: string;
}

const { series, currentPostId } = Astro.props;
---

<details class="series-nav group/series my-3 overflow-hidden rounded-xl border border-(--primary)/25" data-pagefind-ignore>
  <summary class="flex cursor-pointer list-none items-center gap-2 bg-(--btn-plain-bg-hover) px-3 py-1.5">
    <Icon name="material-symbols:format-list-bulleted" aria-hidden="true" class="shrink-0 text-lg text-(--primary)" />
    <span class="min-w-0 flex-1 font-bold text-90">
      {i18n(I18nKey.seriesPartOf)}：{series.name}
    </span>
    <span class="shrink-0 rounded-full bg-(--btn-regular-bg) px-2 py-0.5 text-xs text-(--btn-content)">
      {series.count}
    </span>
    <Icon
      name="material-symbols:keyboard-arrow-down-rounded"
      aria-hidden="true"
      class="shrink-0 text-xl text-(--primary) group-open/series:rotate-180"
    />
  </summary>
  <div class="series-nav-content max-h-[min(50dvh,24rem)] overflow-y-auto overscroll-contain px-1 py-1">
    <SeriesTree entries={series.entries} currentPostId={currentPostId} />
  </div>
</details>

<script is:inline>
  function onSeriesNavToggle(event) {
    var series = event.target;
    if (!(series instanceof HTMLDetailsElement) || !series.matches('.series-nav') || !series.open) return;

    var content = series.querySelector('.series-nav-content');
    var current = content && content.querySelector('[aria-current="page"]');
    if (!current) return;

    // Expand the ancestors before measuring the current row.
    var chapter = current.parentElement.closest('details');
    while (chapter && chapter !== series) {
      chapter.open = true;
      chapter = chapter.parentElement.closest('details');
    }

    var row = current.getBoundingClientRect();
    var viewport = content.getBoundingClientRect();
    if (row.top < viewport.top || row.bottom > viewport.bottom) {
      content.scrollTop += row.top - viewport.top - (content.clientHeight - row.height) / 2;
    }
  }

  // Capture the non-bubbling event, including after Swup replaces the article.
  if (!window.__seriesNavInit) {
    window.__seriesNavInit = true;
    document.addEventListener('toggle', onSeriesNavToggle, true);
  }
</script>
